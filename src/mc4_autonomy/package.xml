<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mc4_autonomy</name>
  <version>0.1.0</version>
  <description>Autonomous missions for the MC 4.0 on top of Nav2 (waypoint patrol).</description>
  <maintainer email="matrixcodelab@gmail.com">Matrix Code Lab</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

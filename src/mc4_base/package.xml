<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mc4_base</name>
  <version>0.1.0</version>
  <description>
    ROS 2 driver for the MC 4.0 base: /cmd_vel to wheel speeds over serial,
    encoder odometry to /odom + TF, plus a fake-hardware mode and a fake lidar
    so SLAM and Nav2 can be tried without the robot.
  </description>
  <maintainer email="matrixcodelab@gmail.com">Matrix Code Lab</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
